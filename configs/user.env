# User / cluster settings. Edit the values below (or export them before running)
# to match your machine. Every launcher and Slurm job sources this file; Python
# reads these as environment variables. Any value can be overridden from the
# calling environment, e.g.
#   DUALOPSD_SCRATCH=/path/to/outputs bash scripts/main.sh --dry-run

_user_env_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export DUALOPSD_REPO="${DUALOPSD_REPO:-$(dirname "$_user_env_dir")}"
unset _user_env_dir

# Storage: every run, merged model, evaluation and summary goes below here.
export DUALOPSD_SCRATCH="${DUALOPSD_SCRATCH:-$DUALOPSD_REPO/outputs}"

# Software environment: conda env from environment.yml. Empty: use the python
# environment that is already active when the job starts.
export CONDA_ENV="${CONDA_ENV-dualopsd}"
# Space-separated environment modules loaded before conda; empty to skip.
export CLUSTER_MODULES="${CLUSTER_MODULES-}"

# Slurm. Fill in your cluster's account and partition; empty values are not
# passed to sbatch. The paper runs used one A100 80GB per GPU job: set
# SLURM_GPU_GRES (e.g. gpu:a100:1) or SLURM_GPU_CONSTRAINT (your site's feature
# string for 80GB A100 nodes) to request that hardware.
export SLURM_ACCOUNT="${SLURM_ACCOUNT-}"
export SLURM_PARTITION="${SLURM_PARTITION-}"
export SLURM_GPU_GRES="${SLURM_GPU_GRES:-gpu:1}"
export SLURM_GPU_CONSTRAINT="${SLURM_GPU_CONSTRAINT-}"  # empty: no constraint

# Base models: local directories or Hugging Face ids. Hub ids are fetched into
# $HF_HOME on first use (scripts/prepare_data.sh --download-models pre-downloads
# them to $DUALOPSD_SCRATCH/base_models/<name> instead).
export MODEL_QWEN3_1P7B="${MODEL_QWEN3_1P7B:-Qwen/Qwen3-1.7B}"
export MODEL_QWEN3_4B="${MODEL_QWEN3_4B:-Qwen/Qwen3-4B}"
export MODEL_QWEN3_8B="${MODEL_QWEN3_8B:-Qwen/Qwen3-8B}"
# Terminal-answer judge for the 500-problem held-out set.
export JUDGE_MODEL="${JUDGE_MODEL:-$MODEL_QWEN3_8B}"

# Data (written by scripts/prepare_data.sh).
export DATA_DIR="${DATA_DIR:-$DUALOPSD_REPO/data/processed}"
export BENCH_DIR="${BENCH_DIR:-$DUALOPSD_REPO/data/benchmarks}"
export TRAIN_FILE="${TRAIN_FILE:-$DATA_DIR/train_openthoughts_30k.jsonl}"
export HELDOUT_FILE="${HELDOUT_FILE:-$DATA_DIR/heldout_500.jsonl}"

# Hugging Face cache.
export HF_HOME="${HF_HOME:-$DUALOPSD_SCRATCH/hf_cache}"
